# --- LLM providers (all free tiers, no card needed) ---
GEMINI_API_KEY=            # https://aistudio.google.com
GROQ_API_KEY=              # https://console.groq.com
OPENROUTER_API_KEY=        # https://openrouter.ai
CEREBRAS_API_KEY=          # https://cloud.cerebras.ai  (optional fallback)

# --- GitHub ---
GITHUB_TOKEN=              # fine-grained PAT scoped ONLY to your test repos
GITHUB_ALLOWED_REPOS=your-user/test-repo-one,your-user/test-repo-two
DRY_RUN=true               # keep true until Phase 5

# --- app ---
LOG_LEVEL=INFO
